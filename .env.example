# ---- Database (Supabase Postgres) ----
# Pooled connection (Supavisor transaction pooler, port 6543) used at runtime
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) used for migrations
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ---- Supabase Realtime (broadcast only) ----
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SERVER ONLY. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Telegram ----
TELEGRAM_BOT_TOKEN="123456:ABC-from-BotFather"
TELEGRAM_BOT_USERNAME="taf_fuel_bot"
TELEGRAM_WEBHOOK_SECRET="long-random-string-A-Za-z0-9_-"
TELEGRAM_MINI_APP_URL="https://your-app.vercel.app"

# ---- App ----
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# 32+ random chars: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
# Reject Mini App initData older than this (seconds)
INIT_DATA_MAX_AGE_SECONDS="86400"

# ---- Maps (Leaflet + OSM needs no token; only for a paid provider later) ----
NEXT_PUBLIC_MAP_PROVIDER="osm"
MAP_PROVIDER_TOKEN=""
NEXT_PUBLIC_MAP_TOKEN=""

# ---- Seed (your real Telegram numeric IDs; no passwords are used anywhere) ----
SEED_SUPER_ADMIN_TELEGRAM_ID="111111111"
SEED_BOLE_ADMIN_TELEGRAM_ID="222222222"
SEED_SARIS_ADMIN_TELEGRAM_ID="333333333"
SEED_MEGENAGNA_ADMIN_TELEGRAM_ID="444444444"
